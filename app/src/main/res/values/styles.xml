<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.iOS.Body" parent="@style/TextAppearance.AppCompat">
        <item name="android:textSize">17.0sp</item>
        <item name="android:textColor">@color/ios_label</item>
    </style>
    <style name="TextAppearance.iOS.LargeTitle" parent="@style/TextAppearance.AppCompat">
        <item name="android:textSize">34.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ios_label</item>
    </style>
    <style name="TextAppearance.iOS.Secondary" parent="@style/TextAppearance.AppCompat">
        <item name="android:textSize">15.0sp</item>
        <item name="android:textColor">@color/ios_label_secondary</item>
    </style>
    <style name="TextAppearance.iOS.SectionHeader" parent="@style/TextAppearance.AppCompat">
        <item name="android:textSize">13.0sp</item>
        <item name="android:textColor">@color/ios_label_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="TextAppearance.iOS.Title" parent="@style/TextAppearance.AppCompat">
        <item name="android:textSize">22.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ios_label</item>
    </style>
    <style name="Theme.MCPBridge" parent="@style/Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ios_bg_grouped</item>
        <item name="android:statusBarColor">@color/ios_bg_grouped</item>
        <item name="android:navigationBarColor">@color/ios_bg_grouped</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorAccent">@color/ios_blue</item>
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorPrimaryDark">@color/ios_blue</item>
    </style>
    <style name="Widget.iOS.Button" parent="@style/Widget.MaterialComponents.Button">
        <item name="android:textSize">17.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">50.0dip</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0.0dip</item>
        <item name="cornerRadius">14.0dip</item>
    </style>
    <style name="Widget.iOS.Button.Filled" parent="@style/Widget.iOS.Button">
        <item name="android:textColor">@color/ios_label_on_blue</item>
        <item name="backgroundTint">@color/ios_blue</item>
    </style>
    <style name="Widget.iOS.Button.Outlined" parent="@style/Widget.iOS.Button">
        <item name="android:textColor">@color/ios_red</item>
        <item name="backgroundTint">@color/ios_bg_card</item>
        <item name="strokeColor">@color/ios_separator</item>
        <item name="strokeWidth">1.0dip</item>
    </style>
</resources>